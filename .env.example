# Copy this file to .env and adjust the values. Never commit the real .env file.
DJANGO_DEBUG=True
# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed only when serving over HTTPS on a real domain, e.g. https://shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to False only if you test production mode (DEBUG=False) over plain HTTP.
DJANGO_SECURE_COOKIES=True
